# .env
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
REDIS_URL=
SEED_INTERVAL_HOURS=
SEED_LIMIT=
SEED_ON_STARTUP=
# OLLAMA_NUM_PARALLEL= # OLLAMA_NUM_PARALLEL= ollama serve

# ── LLM provider (Feature P) ──────────────────────────────────────────────────
# Supported: ollama | openai | anthropic  (default: ollama)
LLM_PROVIDER=
# Model name for the chosen provider  (default: llama3)
LLM_MODEL=
# Required only when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# Required only when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
